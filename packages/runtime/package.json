{
  "name": "@threxus/runtime",
  "version": "0.1.0",
  "description": "A feature-oriented runtime for maintainable Three.js applications",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch --no-dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:types": "tsc -p tests/types/tsconfig.json"
  },
  "peerDependencies": {
    "three": ">=0.180.0 <1"
  },
  "dependencies": {
    "es-toolkit": "^1.46.0"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "@types/three": "0.180.0",
    "@vitest/browser-playwright": "^4.1.11",
    "playwright": "^1.62.1",
    "three": "^0.180.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
