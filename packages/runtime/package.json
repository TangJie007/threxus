{
  "name": "@threxus/runtime",
  "version": "0.1.0",
  "description": "Application runtime and main loop for Threxus",
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch --no-dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@threxus/core": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
