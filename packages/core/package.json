{
  "name": "@threxus/core",
  "version": "0.1.0",
  "description": "Dependency injection primitives for Three.js applications",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rslib/core": "^0.23.2",
    "typescript": "~5.9.3"
  }
}

