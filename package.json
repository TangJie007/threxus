{
  "name": "threxus-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace for the Threxus Three.js runtime",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "docs:dev": "vitepress dev docs --port 5175",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --port 4175"
  },
  "devDependencies": {
    "turbo": "^2.10.12",
    "vitepress": "^1.6.4",
    "vue": "^3.5.42"
  }
}
